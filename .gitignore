# Uploaded quotation/PO/invoice/DO/other files are runtime data, not source.
# Each job order gets its own per-quotation-no folder created on demand by
# FileUploadService (uploads/{quotation_no}/{quotation,po,invoices,do,other}/)
# — nothing under here needs to be tracked except the top-level .htaccess
# that blocks PHP execution across the whole tree.
/public/uploads/*
!/public/uploads/.htaccess

# Application logs
/storage/logs/*.log

# OS/editor cruft
Thumbs.db
.DS_Store

# API keys — copy config/secrets.example.php to config/secrets.php and fill in real values there
/config/secrets.php

# Per-environment settings (APP_ENV/APP_DEBUG/APP_URL) and DB credentials —
# differ between local dev and production, so a `git pull` on a production
# server must never be able to overwrite them. Copy config/env.example.php
# to config/env.php, and config/database.example.php to config/database.php,
# then fill in real values in each.
/config/env.php
/config/database.php
